      "op": "regex",
      "value": "^fp_[0-9a-f]{10}$",
      "weight": 1,
      "note": {
        "zh": "system_fingerprint 为 OpenAI 的 fp_ 格式（多数网关可生成，不作为上游判定依据）",
        "en": "system_fingerprint in OpenAI's fp_ format (many gateways generate it; not used to identify the upstream)"
      }
    },
    {
      "id": "deepseek-tool-id",

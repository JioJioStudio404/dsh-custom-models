    {
      "id": "moonshot-tool-id",
      "field": "toolId",
      "op": "regex",
      "value": "^functions\\.[A-Za-z0-9_-]+:\\d+$",
      "channel": "moonshot",
      "weight": 3,
      "note": {
        "zh": "工具调用 ID 为 Kimi 的 functions.名称:序号 格式",
        "en": "Tool call ID in Kimi's functions.name:index format"

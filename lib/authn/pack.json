    },
    {
      "id": "vllm-tool-id",
      "field": "toolId",
      "op": "regex",
      "value": "^chatcmpl-tool-[0-9a-f]{32}$",
      "channel": "vllm",
      "weight": 3,
      "note": {
        "zh": "工具调用 ID 为 vLLM 的 chatcmpl-tool- 格式（自部署开源模型）",
        "en": "Tool call ID in vLLM's chatcmpl-tool- format (self-hosted open model)"
      }
    }

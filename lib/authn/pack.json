  "thresholds": {},
  "probes": {
    "echo": {
      "phrasings": {
        "en": [
          "Reply with one short sentence about {topic}.",
          "Write one sentence describing {topic}.",
          "In one sentence, tell me something about {topic}."
        ],
        "zh": [
          "用一句话说说{topiczh}。",
          "请用一句话描述{topiczh}。",
          "关于{topiczh}，用一句话讲一点。"
        ]
      },
      "slots": {
        "topic": [
          "the ocean",
          "autumn leaves",
          "a lighthouse",
          "fresh coffee",
          "a mountain trail",
          "a quiet library",
          "summer rain",
          "an old bicycle",
          "the night sky",
          "a busy market"
        ],
        "topiczh": [
          "大海",
          "秋天的落叶",
          "灯塔",
          "刚煮好的咖啡",
          "山间小路",
          "安静的图书馆",
          "夏天的雨",
          "一辆旧自行车",
          "夜空",
          "热闹的集市"
        ]
      }
    },
    "maxtokens": {
      "phrasings": {
        "en": [
          "List the whole numbers from 1 to {top}, separated by spaces.",
          "Write every whole number from 1 up to {top}, one after another with spaces."
        ],
        "zh": [
          "把 1 到 {top} 的整数依次写出来，用空格隔开。"
        ]
      },
      "slots": {
        "top": [
          "60",
          "80",
          "100"
        ]
      }
    },
    "stop": {
      "phrasings": {
        "en": [
          "Count from 1 to 15, separated by spaces, and write nothing else.",
          "Write the numbers 1 through 15 separated by single spaces and nothing more."
        ],
        "zh": [
          "从 1 数到 15，数字之间用空格隔开，不要写别的。"
        ]
      }
    },
    "tool": {
      "phrasings": {
        "en": [
          "What is the weather in {city} right now? Use the tool.",
          "Check the current weather in {city} with the tool."
        ],
        "zh": [
          "{cityzh}现在天气怎么样？请调用工具查询。",
          "用工具查一下{cityzh}现在的天气。"
        ]
      },
      "slots": {
        "city": [
          "Lisbon",
          "Osaka",
          "Toronto",
          "Nairobi",
          "Hamburg",
          "Lima",
          "Hanoi",
          "Perth"
        ],
        "cityzh": [
          "成都",
          "青岛",
          "昆明",
          "厦门",
          "哈尔滨",
          "西安",
          "南宁",
          "兰州"
        ]
      }
    },
    "image": {
      "phrasings": {
        "en": [
          "What single color fills this image? Answer with one word.",
          "Name the color of this image in one word."
        ],
        "zh": [
          "这张图片是什么颜色？只回答一个词。"
        ]
      },
      "expect": [
        "red",
        "红"
      ]
    },
    "signature": {
      "phrasings": {
        "en": [
          "How many positive integers below {n} are divisible by {a} or by {b} but not by both? Think it through, then give the number only.",
          "Count the positive integers less than {n} that are multiples of {a} or of {b}, but not of both. Work it out, then reply with the number only."
        ]
      },
      "slots": {
        "n": [
          "500",
          "700",
          "900",
          "1000",
          "1200"
        ],
        "a": [
          "6",
          "7",
          "9"
        ],
        "b": [
          "11",
          "13"
        ]
      }
    },
    "followup": {
      "phrasings": {
        "en": [
          "Reply with exactly: OK"
        ]
      }
    }
  },
